<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-windows10.0.19041.0;net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>ShellX</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- The WinRT AOT advice for [ObservableProperty] fields does not apply to this unpackaged desktop app. -->
		<NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>ShellX</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.shellx</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" Color="#FFFFFF" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Settings, read at startup via FileSystem.OpenAppPackageFileAsync("appsettings.json") -->
		<MauiAsset Include="appsettings.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="LiveChartsCore.SkiaSharpView.Maui" Version="2.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.Http.Extensions" Version="2.3.13" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="10.0.13" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ProjectX.Core\ProjectX.Core.csproj" />
		<ProjectReference Include="..\ProjectX.MachineLearning.Accord\ProjectX.MachineLearning.Accord.csproj" />
		<ProjectReference Include="..\ProjectX.MachineLearning\ProjectX.MachineLearning.csproj" />
		<ProjectReference Include="..\ProjectX.MarketData.Cache\ProjectX.MarketData.Cache.csproj" />
		<ProjectReference Include="..\ProjectX.MarketData\ProjectX.MarketData.csproj" />
	</ItemGroup>

</Project>
