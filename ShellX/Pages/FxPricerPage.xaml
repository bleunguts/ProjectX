<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ShellX.Pages.FxPricerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ShellX.Controls"
    xmlns:fx="clr-namespace:ShellX.Fx"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    xmlns:vm="clr-namespace:ShellX.ViewModels"
    x:DataType="vm:FxPricerViewModel"
    Title="FXPricer (FX)">

    <Grid Padding="10" ColumnDefinitions="*,*" ColumnSpacing="10">

        <ScrollView Grid.Column="0">
            <VerticalStackLayout Spacing="10">

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Client and pair" Style="{StaticResource SectionHeader}" />
                        <Grid ColumnDefinitions="80,150,*" RowDefinitions="Auto,Auto" RowSpacing="2" ColumnSpacing="6">
                            <Label Text="ClientName:" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Text="{Binding ClientName}" IsReadOnly="True" />
                            <Label Grid.Row="1" Text="Currency:" VerticalOptions="Center" />
                            <Picker Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Currency}" SelectedItem="{Binding SelectedCurrency}" />
                            <HorizontalStackLayout Grid.Row="1" Grid.Column="2" Spacing="4">
                                <Button Text="Subscribe" Command="{Binding SubscribeCommand}" />
                                <Button Text="Unsubscribe" Command="{Binding UnsubscribeCommand}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid x:Name="PriceFlash" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4" Padding="4">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="Latest price" Style="{StaticResource SectionHeader}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding TickArrow}" FontSize="16" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding TickDirection}" Value="Up">
                                        <Setter Property="TextColor" Value="{StaticResource Positive}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding TickDirection}" Value="Down">
                                        <Setter Property="TextColor" Value="{StaticResource Negative}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <HorizontalStackLayout Grid.Column="3" Spacing="5" VerticalOptions="Center">
                                <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="Gray" VerticalOptions="Center">
                                    <BoxView.Triggers>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding IsLive}" Value="True">
                                            <Setter Property="Color" Value="{StaticResource Positive}" />
                                        </DataTrigger>
                                    </BoxView.Triggers>
                                </BoxView>
                                <Label Text="LIVE" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout>
                                <Label Text="BID" FontSize="11" TextColor="{StaticResource Gray500}" />
                                <Label>
                                    <Label.FormattedString>
                                        <FormattedString>
                                            <Span Text="{Binding BidParts.Prefix}" FontSize="20" />
                                            <Span Text="{Binding BidParts.Big}" FontSize="42" FontAttributes="Bold" />
                                            <Span Text="{Binding BidParts.Fraction}" FontSize="22" />
                                        </FormattedString>
                                    </Label.FormattedString>
                                </Label>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="ASK" FontSize="11" TextColor="{StaticResource Gray500}" />
                                <Label>
                                    <Label.FormattedString>
                                        <FormattedString>
                                            <Span Text="{Binding AskParts.Prefix}" FontSize="20" />
                                            <Span Text="{Binding AskParts.Big}" FontSize="42" FontAttributes="Bold" />
                                            <Span Text="{Binding AskParts.Fraction}" FontSize="22" />
                                        </FormattedString>
                                    </Label.FormattedString>
                                </Label>
                            </VerticalStackLayout>
                        </Grid>

                        <Border Grid.Row="2" HorizontalOptions="Start" Padding="10,2" StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Label Text="{Binding SpreadInPips}" FontSize="11" />
                        </Border>

                        <Label Grid.Row="3" Text="{Binding LatestPriceTimeStamp}" FontSize="11" FontAttributes="Italic" TextColor="{StaticResource Gray500}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Trade" Style="{StaticResource SectionHeader}" />
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="Quantity:" VerticalOptions="Center" />
                            <Entry Text="{Binding Notional}" Keyboard="Numeric" WidthRequest="120" />
                        </HorizontalStackLayout>
                        <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding QuantityChips}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="fx:FxQuantityChip">
                                    <Button Text="{Binding Label}" Margin="0,0,4,4" Padding="12,0" CornerRadius="14"
                                            CommandParameter="{Binding Value}" Clicked="OnQuantityChipClicked" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Text="{Binding SellLabel}" Command="{Binding SellTradeCommand}" IsEnabled="{Binding HasPrice}"
                                    BackgroundColor="{StaticResource Sell}" TextColor="White" FontAttributes="Bold" HeightRequest="44" />
                            <Button Grid.Column="1" Text="{Binding BuyLabel}" Command="{Binding BuyTradeCommand}" IsEnabled="{Binding HasPrice}"
                                    BackgroundColor="{StaticResource Buy}" TextColor="White" FontAttributes="Bold" HeightRequest="44" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="Positions" Style="{StaticResource SectionHeader}" VerticalOptions="Center" />
                            <Button Grid.Column="2" Text="Show Positions" Command="{Binding ShowPositionsCommand}" />
                        </Grid>
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Total PnL" VerticalOptions="End" TextColor="{StaticResource Gray500}" />
                            <controls:CountUpLabel Value="{Binding TotalPnl}" FontSize="30" FontAttributes="Bold" />
                        </HorizontalStackLayout>
                        <controls:SimpleGrid Table="{Binding PositionsTable}" SignColorColumn="PnL" BodyHeight="110" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Column="1" RowDefinitions="Auto,2*,*,Auto" RowSpacing="10">

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="4">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="Live Stream:" Style="{StaticResource SectionHeader}" />
                        <Label Text="{Binding PriceStream}" FontAttributes="Bold" />
                    </HorizontalStackLayout>
                    <Grid ColumnDefinitions="*,200" ColumnSpacing="8">
                        <lvc:CartesianChart Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"
                                            Sections="{Binding Sections}" HeightRequest="220" />
                        <controls:SpreadLadderView Grid.Column="1" HeightRequest="220" HasPrice="{Binding HasPrice}"
                                                   Bid="{Binding LadderBid}" Ask="{Binding LadderAsk}" Trail="{Binding LadderTrail}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}">
                <Grid RowDefinitions="Auto,*" RowSpacing="4">
                    <Label Text="Price history (newest first)" Style="{StaticResource SectionHeader}" />
                    <CollectionView Grid.Row="1" ItemsSource="{Binding Prices}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Text="{Binding .}" FontSize="12" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}">
                <Grid RowDefinitions="Auto,*" RowSpacing="4">
                    <Label Text="Tail:" Style="{StaticResource SectionHeader}" />
                    <Editor Grid.Row="1" Text="{Binding StatusLog, Mode=OneWay}" IsReadOnly="True" FontSize="11" />
                </Grid>
            </Border>

            <Button Grid.Row="3" Text="Clear History" Command="{Binding ClearHistoryCommand}" HorizontalOptions="Start" />
        </Grid>
    </Grid>

</ContentPage>
