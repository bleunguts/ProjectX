<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ShellX.Pages.FxPricerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ShellX.Controls"
    xmlns:fx="clr-namespace:ShellX.Fx"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    xmlns:vm="clr-namespace:ShellX.ViewModels"
    x:DataType="vm:FxPricerViewModel"
    Title="FXPricer (FX)">

    <Grid Padding="10" ColumnDefinitions="*,*" ColumnSpacing="10">

        <ScrollView Grid.Column="0">
            <VerticalStackLayout Spacing="10">

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Client and pair" Style="{StaticResource SectionHeader}" />
                        <Grid ColumnDefinitions="80,150,*" RowDefinitions="Auto,Auto" RowSpacing="2" ColumnSpacing="6">
                            <Label Text="ClientName:" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Text="{Binding ClientName}" IsReadOnly="True" />
                            <Label Grid.Row="1" Text="Currency:" VerticalOptions="Center" />
                            <Picker Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Currency}" SelectedItem="{Binding SelectedCurrency}" />
                            <HorizontalStackLayout Grid.Row="1" Grid.Column="2" Spacing="4">
                                <Button Text="Subscribe" Command="{Binding SubscribeCommand}" />
                                <Button Text="Unsubscribe" Command="{Binding UnsubscribeCommand}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Latest Price" Style="{StaticResource SectionHeader}" />

                        <!-- Price tiles: tap to trade. Handle small, the two "big figure" digits large, the last digit small (1.08 | 43 | 2). -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Border BackgroundColor="{StaticResource Sell}" StrokeThickness="0" HeightRequest="130" Padding="14,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SellTradeCommand}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding HasPrice}" Value="False">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                                    <Label Text="SELL" TextColor="White" FontSize="13" FontAttributes="Bold" />
                                    <HorizontalStackLayout Spacing="0">
                                        <Label Text="{Binding BidParts.Prefix}" TextColor="White" FontSize="26" VerticalOptions="End" />
                                        <Label Text="{Binding BidParts.Big}" TextColor="White" FontSize="64" FontAttributes="Bold" VerticalOptions="End" />
                                        <Label Text="{Binding BidParts.Fraction}" TextColor="White" FontSize="32" VerticalOptions="End" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="1" BackgroundColor="{StaticResource Buy}" StrokeThickness="0" HeightRequest="130" Padding="14,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BuyTradeCommand}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding HasPrice}" Value="False">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                                    <Label Text="BUY" TextColor="White" FontSize="13" FontAttributes="Bold" />
                                    <HorizontalStackLayout Spacing="0">
                                        <Label Text="{Binding AskParts.Prefix}" TextColor="White" FontSize="26" VerticalOptions="End" />
                                        <Label Text="{Binding AskParts.Big}" TextColor="White" FontSize="64" FontAttributes="Bold" VerticalOptions="End" />
                                        <Label Text="{Binding AskParts.Fraction}" TextColor="White" FontSize="32" VerticalOptions="End" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <!-- Quantity is secondary to the price, so it sits last and small. -->
                        <FlexLayout Wrap="Wrap" AlignItems="Center">
                            <Label Text="Quantity:" FontSize="11" VerticalOptions="Center" Margin="0,0,6,0" />
                            <Entry Text="{Binding Notional}" Keyboard="Numeric" FontSize="11" WidthRequest="90" MinimumHeightRequest="22" Margin="0,0,8,0" />
                            <FlexLayout Wrap="Wrap" AlignItems="Center" BindableLayout.ItemsSource="{Binding QuantityChips}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="fx:FxQuantityChip">
                                        <Button Text="{Binding Label}" Margin="0,0,4,0" Padding="8,0" CornerRadius="10" FontSize="11"
                                                MinimumHeightRequest="22" HeightRequest="24" MinimumWidthRequest="22"
                                                CommandParameter="{Binding Value}" Clicked="OnQuantityChipClicked" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="Positions" Style="{StaticResource SectionHeader}" VerticalOptions="Center" />
                            <Button Grid.Column="2" Text="Show Positions" Command="{Binding ShowPositionsCommand}" />
                        </Grid>
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Total PnL" VerticalOptions="End" TextColor="{StaticResource Gray500}" />
                            <controls:CountUpLabel Value="{Binding TotalPnl}" FontSize="30" FontAttributes="Bold" />
                        </HorizontalStackLayout>
                        <controls:SimpleGrid Table="{Binding PositionsTable}" SignColorColumn="PnL" BodyHeight="110" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,2*,*,Auto" RowSpacing="10">

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="4">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="Live Stream:" Style="{StaticResource SectionHeader}" />
                        <Label Text="{Binding PriceStream}" FontAttributes="Bold" />
                    </HorizontalStackLayout>
                    <Grid ColumnDefinitions="*,200" ColumnSpacing="8">
                        <lvc:CartesianChart Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"
                                            Sections="{Binding Sections}" HeightRequest="220" />
                        <controls:SpreadLadderView Grid.Column="1" HeightRequest="220" HasPrice="{Binding HasPrice}"
                                                   Bid="{Binding LadderBid}" Ask="{Binding LadderAsk}" Trail="{Binding LadderTrail}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- The short latest-price bar: the full bid/ask text, direction arrow, spread, LIVE dot and time. It flashes green/red on each tick. -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <Grid x:Name="PriceFlash" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="10" Padding="4,2">
                    <Label Text="Last tick" Style="{StaticResource SectionHeader}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding LatestPrice}" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="{Binding TickArrow}" FontSize="18" VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding TickDirection}" Value="Up">
                                <Setter Property="TextColor" Value="{StaticResource Positive}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding TickDirection}" Value="Down">
                                <Setter Property="TextColor" Value="{StaticResource Negative}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label Grid.Column="3" Text="{Binding SpreadInPips}" FontSize="11" VerticalOptions="Center" />
                    <HorizontalStackLayout Grid.Column="4" Spacing="5" VerticalOptions="Center">
                        <Label Text="{Binding LatestPriceTimeStamp}" FontSize="11" FontAttributes="Italic" TextColor="{StaticResource Gray500}" VerticalOptions="Center" />
                        <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="Gray" VerticalOptions="Center">
                            <BoxView.Triggers>
                                <DataTrigger TargetType="BoxView" Binding="{Binding IsLive}" Value="True">
                                    <Setter Property="Color" Value="{StaticResource Positive}" />
                                </DataTrigger>
                            </BoxView.Triggers>
                        </BoxView>
                        <Label Text="LIVE" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}">
                <Grid RowDefinitions="Auto,*" RowSpacing="4">
                    <Label Text="Price history (newest first)" Style="{StaticResource SectionHeader}" />
                    <CollectionView Grid.Row="1" ItemsSource="{Binding Prices}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Text="{Binding .}" FontSize="12" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource Card}">
                <Grid RowDefinitions="Auto,*" RowSpacing="4">
                    <Label Text="Tail:" Style="{StaticResource SectionHeader}" />
                    <Editor Grid.Row="1" Text="{Binding StatusLog, Mode=OneWay}" IsReadOnly="True" FontSize="11" />
                </Grid>
            </Border>

            <Button Grid.Row="4" Text="Clear History" Command="{Binding ClearHistoryCommand}" HorizontalOptions="Start" />
        </Grid>
    </Grid>

</ContentPage>
