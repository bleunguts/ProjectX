<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ShellX.Pages.BlackScholesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ShellX.Controls"
    xmlns:vm="clr-namespace:ShellX.ViewModels"
    x:DataType="vm:BlackScholesViewModel"
    Title="Black-Scholes (Options)">

    <Grid x:Name="WideLayout" Padding="10" ColumnDefinitions="2*,3*" ColumnSpacing="10">

        <ScrollView x:Name="LeftScroll" Grid.Column="0">
            <VerticalStackLayout x:Name="LeftStack" Spacing="10">

                <!-- Hero: the selected maturity's price, big figure and small digits like the FX tiles. -->
                <Border x:Name="HeroCard" StrokeThickness="0" Padding="18,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2563EB" Offset="0" />
                            <GradientStop Color="#1E3A8A" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,6" Radius="12" Opacity="0.35" />
                    </Border.Shadow>
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="OPTION PRICE" TextColor="White" FontSize="12" FontAttributes="Bold" Opacity="0.85" VerticalOptions="Center" />
                            <Border Grid.Column="1" Padding="12,3" Stroke="#B3FFFFFF" StrokeThickness="1" BackgroundColor="#33FFFFFF">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="{Binding HeroMaturity}" TextColor="White" FontSize="12" FontAttributes="Bold" />
                            </Border>
                        </Grid>
                        <HorizontalStackLayout Grid.Row="1" Spacing="2">
                            <Label Text="{Binding HeroBig}" TextColor="White" FontSize="60" FontAttributes="Bold" VerticalOptions="End" />
                            <Label Text="{Binding HeroSmall}" TextColor="White" FontSize="30" VerticalOptions="End" Margin="0,0,0,6" />
                        </HorizontalStackLayout>
                        <Label Grid.Row="2" Text="{Binding CalculatorTypeDesc}" TextColor="White" FontSize="11" Opacity="0.8" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Greeks" Style="{StaticResource SectionHeader}" />
                        <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="4">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label Text="DELTA" FontSize="10" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
                                <controls:CountUpLabel Value="{Binding Delta}" Format="0.000" FontSize="18" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                                <Label Text="GAMMA" FontSize="10" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
                                <controls:CountUpLabel Value="{Binding Gamma}" Format="0.0000" FontSize="18" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                                <Label Text="THETA" FontSize="10" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
                                <controls:CountUpLabel Value="{Binding Theta}" Format="0.00" FontSize="18" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center">
                                <Label Text="RHO" FontSize="10" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
                                <controls:CountUpLabel Value="{Binding Rho}" Format="0.00" FontSize="18" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center">
                                <Label Text="VEGA" FontSize="10" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
                                <controls:CountUpLabel Value="{Binding Vega}" Format="0.00" FontSize="18" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Input parameters" Style="{StaticResource SectionHeader}" />

                        <Grid ColumnDefinitions="70,100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="1" ColumnSpacing="6">
                            <Label Grid.Row="0" Text="OptionType" VerticalOptions="Center" />
                            <Picker Grid.Row="0" Grid.Column="1" ItemsSource="{Binding OptionTypes}" SelectedItem="{Binding OptionType}" />
                            <Label Grid.Row="0" Grid.Column="2" Text="Call for a call option, Put for a putoption" FontSize="11" VerticalOptions="Center" />

                            <Label Grid.Row="1" Text="Spot" VerticalOptions="Center" />
                            <Entry Grid.Row="1" Grid.Column="1" Text="{Binding Spot}" Keyboard="Numeric" />
                            <Label Grid.Row="1" Grid.Column="2" Text="Current price of the underlying asset" FontSize="11" VerticalOptions="Center" />

                            <Label Grid.Row="2" Text="Strike" VerticalOptions="Center" />
                            <Entry Grid.Row="2" Grid.Column="1" Text="{Binding Strike}" Keyboard="Numeric" />
                            <Label Grid.Row="2" Grid.Column="2" Text="Strike price" FontSize="11" VerticalOptions="Center" />

                            <Label Grid.Row="3" Text="Rate" VerticalOptions="Center" />
                            <Entry Grid.Row="3" Grid.Column="1" Text="{Binding Rate}" Keyboard="Numeric" />
                            <Label Grid.Row="3" Grid.Column="2" Text="Interest rate" FontSize="11" VerticalOptions="Center" />

                            <Label Grid.Row="4" Text="Carry" VerticalOptions="Center" />
                            <Entry Grid.Row="4" Grid.Column="1" Text="{Binding Carry}" Keyboard="Numeric" />
                            <Label Grid.Row="4" Grid.Column="2" Text="Cost of carry" FontSize="11" VerticalOptions="Center" />

                            <Label Grid.Row="5" Text="Vol" VerticalOptions="Center" />
                            <Entry Grid.Row="5" Grid.Column="1" Text="{Binding Vol}" Keyboard="Numeric" />
                            <Label Grid.Row="5" Grid.Column="2" Text="Volatility" FontSize="11" VerticalOptions="Center" />
                        </Grid>

                        <Label Text="Calculator" FontSize="11" TextColor="{StaticResource Gray500}" Margin="0,6,0,0" />
                        <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding CalculatorChips}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChoiceChip">
                                    <Button Text="{Binding Label}" Style="{StaticResource ChipButton}" Margin="0,0,6,4"
                                            CommandParameter="{Binding Key}" Clicked="OnCalculatorChipClicked">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <!-- A raised action tile, like the FX Sell/Buy tiles. -->
                        <Border BackgroundColor="{StaticResource Primary}" StrokeThickness="0" Padding="16,12" Margin="0,4,0,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.3" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CalculatePriceCommand}" Tapped="OnTileTapped" />
                                <PointerGestureRecognizer PointerEntered="OnTilePointerEntered" PointerExited="OnTilePointerExited" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Label Text="Calculate Price" TextColor="White" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                                <Label Text="›" TextColor="White" FontSize="22" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Results by maturity" Style="{StaticResource SectionHeader}" />
                        <Label Text="Tap a row to see its price and Greeks above." FontSize="11" TextColor="{StaticResource Gray500}" />
                        <controls:SimpleGrid x:Name="ResultsGrid" Table="{Binding OptionTable}" BodyHeight="130" RowSelected="OnResultRowSelected" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Compare with.." Style="{StaticResource SectionHeader}" VerticalOptions="Center" />
                            <Button Text="Show / hide" Command="{Binding ToggleCompareCommand}" />
                        </HorizontalStackLayout>
                        <VerticalStackLayout IsVisible="{Binding IsCompareVisible}" Spacing="6">
                            <FlexLayout Wrap="Wrap" AlignItems="Center">
                                <Button Text="Calculate Price" Command="{Binding CalculatePrice2Command}" Margin="0,2,4,2" />
                                <Entry Text="{Binding CalculatorType2}" IsReadOnly="True" WidthRequest="150" Margin="0,2,4,2" />
                                <Button Text="&gt;" Command="{Binding ToggleCalculator2Command}" WidthRequest="30" Margin="0,2,4,2" />
                                <Label Text="{Binding CalculatorTypeDesc2}" VerticalOptions="Center" FontSize="11" />
                            </FlexLayout>
                            <controls:SimpleGrid x:Name="ResultsGrid2" Table="{Binding OptionTable2}" BodyHeight="130" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Border x:Name="ChartCard" Grid.Column="1" Style="{StaticResource Card}">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="4">
                <Label Text="Plot price and Greeks" Style="{StaticResource SectionHeader}" HorizontalOptions="Center" />
                <FlexLayout Grid.Row="1" Wrap="Wrap" JustifyContent="Center" BindableLayout.ItemsSource="{Binding PlotChips}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChoiceChip">
                            <Button Text="{Binding Label}" Style="{StaticResource ChipButton}" Margin="3,2"
                                    CommandParameter="{Binding Key}" Clicked="OnPlotChipClicked">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
                <controls:Surface3DView Grid.Row="2" Surface="{Binding Surface}" ZLabel="{Binding ZLabel}" MinimumHeightRequest="300" />
                <Label Grid.Row="3" Text="Turns on its own; drag to take control" FontSize="11" HorizontalOptions="Center" />
            </Grid>
        </Border>
    </Grid>

</ContentPage>
