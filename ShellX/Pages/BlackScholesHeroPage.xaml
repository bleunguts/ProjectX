<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ShellX.Pages.BlackScholesHeroPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ShellX.Controls"
    xmlns:vm="clr-namespace:ShellX.ViewModels"
    x:DataType="vm:BlackScholesViewModel"
    BackgroundColor="#0B1020"
    Title="Black-Scholes (Hero)">

    <ContentPage.Resources>
        <!-- Everything here sits on a dark animated backdrop, so colours are explicit rather than theme-bound. -->
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#B31B2236" />
            <Setter Property="Stroke" Value="#33FFFFFF" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="18" />
                </Setter.Value>
            </Setter>
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="Black" Offset="0,6" Radius="14" Opacity="0.4" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GlassChip" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#33FFFFFF" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HeightRequest" Value="28" />
            <Setter Property="MinimumHeightRequest" Value="26" />
        </Style>
    </ContentPage.Resources>

    <Grid x:Name="Root">

        <controls:ShaderBackdropView />

        <controls:Surface3DView x:Name="HeroSurface" Surface="{Binding Surface}" ZLabel="{Binding ZLabel}" OnDark="True" />

        <ScrollView x:Name="Foreground">
            <Grid x:Name="Layout" Padding="14" ColumnDefinitions="380,*" ColumnSpacing="14">

                <ScrollView x:Name="LeftScroll" Grid.Column="0">
                    <VerticalStackLayout Spacing="12">

                        <!-- The price, with a maturity slider: drag it and the price and every dial follow. -->
                        <Border x:Name="HeroCard" Style="{StaticResource GlassCard}">
                            <VerticalStackLayout Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="OPTION PRICE" TextColor="White" FontSize="12" FontAttributes="Bold" Opacity="0.85" VerticalOptions="Center" />
                                    <Border Grid.Column="1" Padding="12,3" Stroke="#B3FFFFFF" StrokeThickness="1" BackgroundColor="#33FFFFFF">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding HeroMaturity}" TextColor="White" FontSize="12" FontAttributes="Bold" />
                                    </Border>
                                </Grid>
                                <HorizontalStackLayout Spacing="2">
                                    <Label Text="{Binding HeroBig}" TextColor="White" FontSize="60" FontAttributes="Bold" VerticalOptions="End" />
                                    <Label Text="{Binding HeroSmall}" TextColor="White" FontSize="30" VerticalOptions="End" Margin="0,0,0,6" />
                                </HorizontalStackLayout>
                                <Slider Minimum="0" Maximum="{Binding MaxMaturityIndex}" Value="{Binding SelectedIndex}" IsEnabled="{Binding HasResults}"
                                        MinimumTrackColor="#3B82F6" MaximumTrackColor="#55FFFFFF" ThumbColor="White" />
                                <Label Text="Drag to scrub through the maturities" TextColor="White" FontSize="11" Opacity="0.6" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource GlassCard}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Inputs" TextColor="#7DB3FF" FontSize="13" FontAttributes="Bold" />
                                <Grid ColumnDefinitions="70,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="1" ColumnSpacing="6">
                                    <Label Grid.Row="0" Text="Type" TextColor="White" VerticalOptions="Center" />
                                    <Picker Grid.Row="0" Grid.Column="1" ItemsSource="{Binding OptionTypes}" SelectedItem="{Binding OptionType}" TextColor="White" TitleColor="White" />
                                    <Label Grid.Row="1" Text="Spot" TextColor="White" VerticalOptions="Center" />
                                    <Entry Grid.Row="1" Grid.Column="1" Text="{Binding Spot}" Keyboard="Numeric" TextColor="White" />
                                    <Label Grid.Row="2" Text="Strike" TextColor="White" VerticalOptions="Center" />
                                    <Entry Grid.Row="2" Grid.Column="1" Text="{Binding Strike}" Keyboard="Numeric" TextColor="White" />
                                    <Label Grid.Row="3" Text="Rate" TextColor="White" VerticalOptions="Center" />
                                    <Entry Grid.Row="3" Grid.Column="1" Text="{Binding Rate}" Keyboard="Numeric" TextColor="White" />
                                    <Label Grid.Row="4" Text="Carry" TextColor="White" VerticalOptions="Center" />
                                    <Entry Grid.Row="4" Grid.Column="1" Text="{Binding Carry}" Keyboard="Numeric" TextColor="White" />
                                    <Label Grid.Row="5" Text="Vol" TextColor="White" VerticalOptions="Center" />
                                    <Entry Grid.Row="5" Grid.Column="1" Text="{Binding Vol}" Keyboard="Numeric" TextColor="White" />
                                </Grid>

                                <FlexLayout Wrap="Wrap" Margin="0,6,0,0" BindableLayout.ItemsSource="{Binding CalculatorChips}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ChoiceChip">
                                            <Button Text="{Binding Label}" Style="{StaticResource GlassChip}" Margin="0,0,6,4"
                                                    CommandParameter="{Binding Key}" Clicked="OnCalculatorChipClicked">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="#2563EB" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>

                                <Border BackgroundColor="#2563EB" StrokeThickness="0" Padding="16,12">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="#2563EB" Offset="0,0" Radius="16" Opacity="0.7" />
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding CalculatePriceCommand}" Tapped="OnTileTapped" />
                                        <PointerGestureRecognizer PointerEntered="OnTilePointerEntered" PointerExited="OnTilePointerExited" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                        <Label Text="Calculate Price" TextColor="White" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                                        <Label Text="›" TextColor="White" FontSize="22" FontAttributes="Bold" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </ScrollView>

                <!-- Plot chips on top, the surface shows through the middle, the Greek dials along the bottom. -->
                <Grid x:Name="RightColumn" Grid.Column="1" RowDefinitions="Auto,*,Auto" RowSpacing="8"
                      InputTransparent="True" CascadeInputTransparent="False">

                    <FlexLayout Wrap="Wrap" JustifyContent="Center" BindableLayout.ItemsSource="{Binding PlotChips}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChoiceChip">
                                <Button Text="{Binding Label}" Style="{StaticResource GlassChip}" Margin="3,2"
                                        CommandParameter="{Binding Key}" Clicked="OnPlotChipClicked">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#2563EB" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="8">
                        <Grid ColumnDefinitions="*,*,*,*,*">
                            <controls:GreekGaugeView Grid.Column="0" HeightRequest="130" Label="{Binding Gauges[0].Name}" ValueText="{Binding Gauges[0].Text}" Fraction="{Binding Gauges[0].Fraction}" />
                            <controls:GreekGaugeView Grid.Column="1" HeightRequest="130" Label="{Binding Gauges[1].Name}" ValueText="{Binding Gauges[1].Text}" Fraction="{Binding Gauges[1].Fraction}" />
                            <controls:GreekGaugeView Grid.Column="2" HeightRequest="130" Label="{Binding Gauges[2].Name}" ValueText="{Binding Gauges[2].Text}" Fraction="{Binding Gauges[2].Fraction}" />
                            <controls:GreekGaugeView Grid.Column="3" HeightRequest="130" Label="{Binding Gauges[3].Name}" ValueText="{Binding Gauges[3].Text}" Fraction="{Binding Gauges[3].Fraction}" />
                            <controls:GreekGaugeView Grid.Column="4" HeightRequest="130" Label="{Binding Gauges[4].Name}" ValueText="{Binding Gauges[4].Text}" Fraction="{Binding Gauges[4].Fraction}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollView>
    </Grid>

</ContentPage>
